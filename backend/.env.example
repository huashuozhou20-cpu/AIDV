# LLM API 配置（兼容 OpenAI 格式，可用于 DeepSeek 等）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=deepseek-chat

# RMDB 数据库连接
# RMDB 启动: ./rmdb <dbname> [TCP端口] [HTTP端口]
# 例如: ./rmdb mydb 8765 8080
DB_HOST=localhost
DB_PORT=8765       # TCP 端口 (回退用)
HTTP_PORT=8080     # HTTP API 端口 (主力)
